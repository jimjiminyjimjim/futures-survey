# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (Project Settings -> API Keys) or `supabase projects api-keys`.
# .env.local is git-ignored; this file is tracked and must never contain
# real values.

# Public browser values — safe to ship in client bundles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional fallback origin for the email sign-in link (emailRedirectTo),
# used only if the inbound request has no usable `host` header. Leave empty
# to derive the origin from the request (host + x-forwarded-proto) instead.
NEXT_PUBLIC_SITE_URL=

# Server-only secret. Used only by tests/ (never by code under src/).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI only (e.g. `supabase db push` when the CLI's own login role
# cannot be used). Not read by the Next.js app.
SUPABASE_DB_PASSWORD=

# Supabase CLI only — used by `supabase config push` for [auth.email.smtp].
# Not read by the Next.js app. Leave empty until custom SMTP is configured
# (see README.md "Email delivery" -> "Switching to custom SMTP").
SUPABASE_AUTH_SMTP_PASS=
